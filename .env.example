# NIDHISETU Configuration (Safe Placeholders for Local Demo)

# Environment: local | demo | production
NIDHISETU_ENVIRONMENT=local

# Database: SQLite for local execution; Postgres for deployment
NIDHISETU_DATABASE_URL=sqlite:///./data/nidhisetu.db

# Security & Secrets
NIDHISETU_JWT_SECRET=insecure-local-development-secret
NIDHISETU_JWT_TTL_MINUTES=60
NIDHISETU_FDR_HMAC_KEY=insecure-local-development-hmac

# AES-256-GCM Master Key (32-byte / 64-hex-char key)
NIDHISETU_AES_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage Backend: filesystem | database
NIDHISETU_STORAGE_BACKEND=filesystem
NIDHISETU_STORAGE_ROOT=./data/objects

# Features & Simulators
NIDHISETU_MOCK_BANK_ENABLED=true
NIDHISETU_EXPOSE_DOCS=true
NIDHISETU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
